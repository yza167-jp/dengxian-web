# HTTP / persistence
PORT=8787
DATABASE_PATH=./data/dengxian.sqlite
PUBLIC_ORIGIN=http://localhost:8787
SESSION_TOKEN_TTL_DAYS=30
DISCONNECT_GRACE_MS=120000
ACTION_TIMEOUT_MS=90000

# DeepSeek official OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BETA_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Optional server-controlled OpenAI-compatible endpoint.
# Never expose these values to the browser and do not accept arbitrary base URLs from clients.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_DEFAULT_MODEL=

# AI reliability controls
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=2
AI_MAX_TOTAL_WAIT_MS=28000
AI_CONCURRENCY_PER_ROOM=1
AI_FALLBACK_PROVIDER=local-bot
AI_CIRCUIT_FAILURE_THRESHOLD=4
AI_CIRCUIT_RESET_MS=60000

# Optional admin-only connectivity test. Leave empty to disable POST /api/provider-test.
PROVIDER_TEST_TOKEN=

# Logging
LOG_LEVEL=info
